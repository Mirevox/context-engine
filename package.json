{
  "name": "@mirevox/context-engine",
  "version": "0.1.0",
  "description": "Shared multi-repo context engine: commit-aware extractive summaries cached in SQLite, served over MCP, CLI and HTTP.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "context-engine": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture:init": "node scripts/init-fixture.mjs",
    "start:mcp": "node dist/cli.js serve-mcp",
    "start:http": "node dist/cli.js serve-http",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
