# Copy to .env and fill in before `docker compose up`.
#   cp .env.example .env

# REQUIRED: bearer token for every HTTP route except GET /health.
# Generate with: openssl rand -hex 32
CONTEXT_ENGINE_TOKEN=change-me-to-a-long-random-secret

# Host port published to 127.0.0.1/0.0.0.0 (container always listens on 7437).
CONTEXT_ENGINE_PUBLISH_PORT=7437

# Host path mounted read-only at /repos inside the container.
# Point this at a directory of local git clones you want to register.
# Default uses the repo fixtures/ for smoke tests.
REPOS_HOST_PATH=./fixtures
